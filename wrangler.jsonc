{
  // Configuración del Worker que sirve la plataforma completa.
  // Un solo Worker sirve los archivos estáticos (public/) y responde las APIs
  // de los tres módulos. Reemplaza a los tres servidor.py.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catenainstituto-desarrollo",
  "main": "src/index.ts",
  "build": { "command": "npm run build:vendimia" },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Smart Placement: el Worker corre cerca de la base D1, no en Buenos Aires.
  // Medido el 2026-11-04 desde la bodega: cada consulta a D1 costaba ~145 ms
  // (el borde EZE responde en 38 ms, pero D1 queda lejos), y un pedido hace
  // 3-6 consultas en fila: /lotes/api/version tardaba 620 ms y la lista de
  // Órdenes de trabajo 2,5 s. Los archivos estáticos se siguen sirviendo desde
  // el borde; solo lo que pasa por el Worker se mueve.
  "placement": { "mode": "smart" },

  // Archivos estáticos: el portal y las pantallas de cada módulo.
  // run_worker_first lista lo que TIENE que pasar por el Worker: las APIs, y
  // el index.html de cada módulo (para inyectarle la identidad de Office 365).
  // Todo lo demás —app.js, fuentes, librerías— lo sirve el CDN directo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/prensas/api/*",
      "/barriles/api/*",
      "/lotes/api/*",
      "/ordenes/api/*",
      "/vendimia/api/*",
      "/vendimia",
      "/vendimia/",
      "/vendimia/index.html",
      "/vendimia/referencias.json",
      "/vendimia/trazabilidad",
      "/vendimia/trazabilidad.html",
      "/prensas",
      "/prensas/",
      "/prensas/index.html",
      "/barriles",
      "/barriles/",
      "/barriles/index.html",
      "/lotes",
      "/lotes/",
      "/lotes/index.html",
      "/ordenes",
      "/ordenes/",
      "/ordenes/index.html",
      "/inventario",
      "/inventario/",
      "/inventario/index.html"
    ]
  },

  // Base de datos D1 de la cuenta (creada el 2026-09-01).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catenainstitute-desarrollo",
      "database_id": "bab98747-2936-431c-a1c6-f8e333eb5a77",
      "migrations_dir": "migrations"
    }
  ],

  // Respaldos: snapshots JSON fechados. Crear el bucket con:
  //   npx wrangler r2 bucket create catenainstitute-respaldos
  "r2_buckets": [
    { "binding": "RESPALDOS", "bucket_name": "catenainstitute-desarrollo-respaldos" }
  ],

  // Asistente IA (reemplaza a Ollama en localhost).
  "ai": { "binding": "AI" },

  // Snapshot diario a las 03:00 UTC (medianoche en Mendoza).
  "triggers": { "crons": ["0 3 * * *", "*/5 * * * *"] },

  "observability": { "enabled": true },

  "vars": {
    // Zona horaria para todos los cálculos de fecha.
    "TZ_BODEGA": "America/Argentina/Mendoza"

    // OJO: acá NO va DEV_EMAIL.
    //
    // Todo lo que está en "vars" se despliega. Si el email de desarrollo
    // viajara a producción, cualquiera que entrara al sitio sin pasar por
    // Access quedaría identificado como ese usuario. Por eso vive en
    // .dev.vars, que solo existe en la máquina donde se programa y está en
    // .gitignore. En producción env.DEV_EMAIL queda sin definir y el Worker
    // exige una identidad real de Access.
  }
}
