{
  // Configuración del Worker que sirve la plataforma completa.
  // Un solo Worker sirve los archivos estáticos (public/) y responde las APIs
  // de los tres módulos. Reemplaza a los tres servidor.py.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciw-plataforma",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Archivos estáticos: el portal y las pantallas de cada módulo.
  // run_worker_first lista lo que TIENE que pasar por el Worker: las APIs, y
  // el index.html de cada módulo (para inyectarle la identidad de Office 365).
  // Todo lo demás —app.js, fuentes, librerías— lo sirve el CDN directo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/prensas/api/*",
      "/barriles/api/*",
      "/lotes/api/*",
      "/prensas",
      "/prensas/",
      "/prensas/index.html",
      "/barriles",
      "/barriles/",
      "/barriles/index.html",
      "/lotes",
      "/lotes/",
      "/lotes/index.html"
    ]
  },

  // Base de datos. El id se completa al crearla:
  //   npx wrangler d1 create ciw-plataforma
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciw-plataforma",
      "database_id": "COMPLETAR_TRAS_CREAR_LA_BASE",
      "migrations_dir": "migrations"
    }
  ],

  // Respaldos: snapshots JSON fechados.
  //   npx wrangler r2 bucket create ciw-respaldos
  "r2_buckets": [
    { "binding": "RESPALDOS", "bucket_name": "ciw-respaldos" }
  ],

  // Asistente IA (reemplaza a Ollama en localhost).
  "ai": { "binding": "AI" },

  // Snapshot diario a las 03:00 UTC (medianoche en Mendoza).
  "triggers": { "crons": ["0 3 * * *"] },

  "observability": { "enabled": true },

  "vars": {
    // Zona horaria para todos los cálculos de fecha.
    "TZ_BODEGA": "America/Argentina/Mendoza",
    // En desarrollo local no existe Cloudflare Access. Este valor identifica
    // al usuario mientras se trabaja con `wrangler dev`. En producción se
    // ignora: manda siempre la identidad real de Access.
    "DEV_EMAIL": "dev@local"
  }
}
