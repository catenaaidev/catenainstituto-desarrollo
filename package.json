{
  "name": "catenainstitute",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma web de Bodegas Esmeralda: Prensas, Mapa de Barriles y Lotes",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:sin-ia": "wrangler dev -c wrangler.dev.jsonc --port 8788 --local",
    "verificar:ocr": "node scripts/verificar-ocr.mjs",
    "deploy": "wrangler deploy",
    "tipos": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrar:local": "wrangler d1 migrations apply catenainstitute --local",
    "migrar:nube": "wrangler d1 migrations apply catenainstitute --remote",
    "importar:prensas": "node scripts/importar.mjs --modulo prensas  --local --datos datos-origen/prensas-datos.json",
    "importar:barriles": "node scripts/importar.mjs --modulo barriles --local --datos datos-origen/estado-barriles.json",
    "importar:lotes": "node scripts/importar.mjs --modulo lotes    --local --datos datos-origen/lotes-datos.json",
    "importar:todo": "npm run importar:prensas && npm run importar:barriles && npm run importar:lotes",
    "reporte:plantillas": "node scripts/extraer-reporte.mjs ../prensas-app/reporte.py src/prensas/reporte-plantilla.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "typescript": "^5.6.0",
    "vitest": "~3.0.0",
    "wrangler": "^4.0.0"
  }
}
